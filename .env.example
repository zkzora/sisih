# Sisih local env. Copy to .env and fill in.
SUI_NETWORK=testnet
TATUM_API_KEY_TESTNET=
TATUM_API_KEY_MAINNET=

# Filled by server/scripts/publish.ts (Phase 1)
SISIH_PACKAGE_ID=
VAULT_ID=
OPERATOR_CAP_ID=
UPGRADE_CAP_ID=
USDC_COIN_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC

# Wallets: suiprivkey... (sui keytool generate ed25519, then sui keytool convert)
# owner address goes here  (scripts only; import into a browser wallet for the dashboard)
OWNER_PRIVATE_KEY=
# operator address goes here
OPERATOR_PRIVATE_KEY=
# agent address goes here
AGENT_PRIVATE_KEY=
# facilitator address goes here
FACILITATOR_PRIVATE_KEY=

# Demo merchants (demo plumbing: keys exist only so recycle.ts can sweep funds back)
MERCHANT_DATAMART_ADDRESS=
MERCHANT_DATAMART_PRIVATE_KEY=
MERCHANT_SEARCHBOX_ADDRESS=
MERCHANT_SEARCHBOX_PRIVATE_KEY=
MERCHANT_REPORTLAB_ADDRESS=
MERCHANT_REPORTLAB_PRIVATE_KEY=

# Demo payees for the seeded obligations (demo plumbing: keys exist only so recycle.ts can sweep funds back)
PAYEE_INFERENCE_PRIVATE_KEY=
PAYEE_HOSTING_PRIVATE_KEY=
PAYEE_SAVINGS_PRIVATE_KEY=
PAYEE_DOMAIN_PRIVATE_KEY=

# Walrus Memory (mainnet), from memory.walrus.xyz
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_NAMESPACE=sisih-demo-1

DEMO_CYCLE_MS=120000
DATABASE_URL=file:./server/data/sisih.db

# Server (optional)
PORT=8787
HOST=127.0.0.1
