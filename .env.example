# Sisih local env. Copy to .env and fill in.
SUI_NETWORK=testnet
TATUM_API_KEY_TESTNET=
TATUM_API_KEY_MAINNET=

# Filled by server/scripts/publish.ts (Phase 1)
SISIH_PACKAGE_ID=
VAULT_ID=
OPERATOR_CAP_ID=
UPGRADE_CAP_ID=
USDC_COIN_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC

# Wallets: suiprivkey... (sui keytool generate ed25519, then sui keytool convert)
# Local owner signer only. Never provide OWNER_PRIVATE_KEY to a Mainnet server.
OWNER_PRIVATE_KEY=
OWNER_ADDRESS=
# operator address goes here
OPERATOR_PRIVATE_KEY=
# agent address goes here
AGENT_PRIVATE_KEY=
# facilitator address goes here
FACILITATOR_PRIVATE_KEY=

# Demo merchants (demo plumbing: keys exist only so recycle.ts can sweep funds back)
MERCHANT_DATAMART_ADDRESS=
MERCHANT_DATAMART_PRIVATE_KEY=
MERCHANT_SEARCHBOX_ADDRESS=
MERCHANT_SEARCHBOX_PRIVATE_KEY=
MERCHANT_REPORTLAB_ADDRESS=
MERCHANT_REPORTLAB_PRIVATE_KEY=
# ChainScope (demo merchant, live Sui Testnet vault report through Tatum)
MERCHANT_CHAINSCOPE_ADDRESS=
MERCHANT_CHAINSCOPE_PRIVATE_KEY=

# Demo payees for the seeded obligations (demo plumbing: keys exist only so recycle.ts can sweep funds back)
PAYEE_INFERENCE_PRIVATE_KEY=
PAYEE_HOSTING_PRIVATE_KEY=
PAYEE_SAVINGS_PRIVATE_KEY=
PAYEE_DOMAIN_PRIVATE_KEY=

# Walrus Memory (mainnet), from memory.walrus.xyz
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_NAMESPACE=sisih-demo-1
# Prefix for namespaces created by demo reset (<prefix>-<n>). Use a different one per deployment.
MEMWAL_NAMESPACE_PREFIX=sisih-demo

DEMO_CYCLE_MS=120000
# Local dev: embedded PGlite. Hosted: Supabase Postgres, transaction pooler (port 6543), e.g.
# postgres://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=pglite:./server/data/pglite
# On Vercel with the Supabase integration, leave DATABASE_URL unset: POSTGRES_URL (transaction pooler) is used.

# Server (optional)
PORT=8787
HOST=127.0.0.1
PUBLIC_BASE_URL=

# Demo controls lock (public URL is read-only without it) and CORS origin(s)
DEMO_TOKEN=
# Agent credential for the MCP endpoint (/api/mcp), separate from DEMO_TOKEN; Authorization: Bearer <value>
SISIH_AGENT_TOKEN=
# Distinct server owner credential (required on Mainnet; Testnet may use DEMO_TOKEN).
SISIH_OWNER_MCP_TOKEN=
# Owner CLI (pnpm sisih). Set these in the owner's shell only, never in the agent's environment.
# SISIH_URL defaults to https://sisih-azure.vercel.app; SISIH_OWNER_TOKEN is the DEMO_TOKEN value
# (the CLI also reads DEMO_TOKEN); SISIH_CLIENT_ID defaults to owner-cli.
SISIH_URL=
SISIH_OWNER_TOKEN=
SISIH_CLIENT_ID=
WEB_ORIGIN=
